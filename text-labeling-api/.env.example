# ===== Application =====
APP_NAME=Text Labeling Platform
APP_ENV=development
DEBUG=true
RUN_DB_BOOTSTRAP=true

# ===== Database =====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/text_labeling_db

# ===== JWT =====
JWT_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Password Reset =====
PASSWORD_RESET_EXPIRE_MINUTES=30

# ===== Email (SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=noreply@textlabeling.com

# ===== Gemini AI Suggestions =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=25

# ===== CORS =====
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","https://textlabel-platform.vercel.app"]

# ===== Security =====
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
